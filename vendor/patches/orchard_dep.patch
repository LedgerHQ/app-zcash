+    const fn hex_decode_96(hex: &[u8; 192]) -> [u8; 96] {
+        let mut out = [0u8; 96];
+        let mut i = 0;
+        while i < 96 {
+            let h = if hex[i * 2] >= b'a' {
+                hex[i * 2] - b'a' + 10
+            } else {
+                hex[i * 2] - b'0'
+            };
+            let l = if hex[i * 2 + 1] >= b'a' {
+                hex[i * 2 + 1] - b'a' + 10
+            } else {
+                hex[i * 2 + 1] - b'0'
+            };
+            out[i] = (h << 4) | l;
+            i += 1;
+        }
+        out
+    }
