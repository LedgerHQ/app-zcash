+        let nf_old = Nullifier::from_bytes(&nullifier_bytes).unwrap();
+        let rho = Rho::from_nf_old(nf_old);
+
+        // Fixed rseed distinct from _DUMMY_RSEED (0x30) to produce a different V3 cmx.
+        let rseed_bytes: [u8; 32] = {
