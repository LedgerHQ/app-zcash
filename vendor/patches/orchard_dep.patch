+            NoteVersion::V3,
+        ))
+        .expect("external spend note must be valid");
+
+        let ext_nullifier = spend_note.nullifier(&fvk);
+        let ext_nf_bytes = ext_nullifier.to_bytes();
+        println!(
+            "_EXT_NULLIFIER = bytes.fromhex(\"{}\")",
+            hex_str(&ext_nf_bytes)
+        );
+
+        // ── V3 output note (value = 180 000, rho = ext_nullifier) ────────
+        // The Ironwood value pool carries V3 note plaintexts only.
+        let ext_div = Diversifier::from_bytes(EXT_RECIPIENT[..11].try_into().unwrap());
+        let ext_pk_d =
+            DiversifiedTransmissionKey::from_bytes(EXT_RECIPIENT[11..].try_into().unwrap())
+                .expect("ext_recipient pk_d must be valid");
+        let ext_addr = Address::from_parts(ext_div, ext_pk_d);
+
+        let ext_output_rho = Rho::from_bytes(&ext_nf_bytes)
+            .into_option()
+            .expect("ext_nullifier must be a valid field element");
+        let ext_rseed = Option::from(RandomSeed::from_bytes(EXT_RSEED, &ext_output_rho))
+            .expect("EXT_RSEED must be valid for rho");
+        let ext_output_note: Note = Option::from(Note::from_parts(
+            ext_addr,
+            NoteValue::from_raw(180_000),
+            ext_output_rho,
+            ext_rseed,
+            NoteVersion::V3,
+        ))
+        .expect("external output note must be valid");
+
+        let ext_cmx = ExtractedNoteCommitment::from(ext_output_note.commitment());
+        let ext_cmx_bytes = ext_cmx.to_bytes();
+        println!("_EXT_CMX = bytes.fromhex(\"{}\")", hex_str(&ext_cmx_bytes));
+
+        // ── Encrypt output note (external OVK) ───────────────────────────
+        let esk = ext_output_note.esk();
+        let encryptor =
+            IronwoodNoteEncryption::new_with_esk(esk, Some(ext_ovk), ext_output_note, [0u8; 512]);
+        let epk_bytes = IronwoodDomain::epk_bytes(encryptor.epk());
+        println!(
+            "_EXT_EPHEMERAL_KEY = bytes.fromhex(\"{}\")",
+            hex_str(&epk_bytes.0)
+        );
+
+        let enc_ct = encryptor.encrypt_note_plaintext();
+        println!(
+            "_EXT_ENC_CIPHERTEXT = bytes.fromhex(\n    \"{}\"\n)",
+            hex_lines(enc_ct.as_ref())
+        );
+
+        // cv_net = ValueCommitment::derive(net = 20000, rcv = EXT_RCV)
+        let ext_rcv = ValueCommitTrapdoor::from_bytes(EXT_RCV)
+            .into_option()
+            .expect("EXT_RCV must be a valid scalar");
+        let value_net = NoteValue::from_raw(200_000) - NoteValue::from_raw(180_000);
+        let ext_cv_net = ValueCommitment::derive(value_net, ext_rcv);
+
+        let out_ct =
+            encryptor.encrypt_outgoing_plaintext(&ext_cv_net, &ext_cmx, &mut UnwrapErr(SysRng));
+        println!(
+            "_EXT_OUT_CIPHERTEXT = bytes.fromhex(\n    \"{}\"\n)",
+            hex_lines(out_ct.as_ref())
+        );
+    }
+
+    /// The note and outgoing viewing key behind the V3 memo action.
+    ///
+    /// Rebuilt on each call because encrypting consumes the note. Everything here is fixed:
+    /// the only thing that varies between the memo vectors below is the memo itself, and a
+    /// memo reaches neither the note commitment nor the outgoing ciphertext — the first covers
+    /// the note, the second is keyed by cv_net, cmx and the ephemeral key. So `cmx`,
+    /// `_MEMO_EPHEMERAL_KEY`, `_MEMO_CV_NET` and `_MEMO_OUT_CIPHERTEXT` hold for every memo,
+    /// and a new memo has to regenerate `enc_ciphertext` alone.
+    fn memo_action_note_and_ovk() -> (Note, OutgoingViewingKey) {
+        let fvk = FullViewingKey::from_bytes(&FVK_BYTES).expect("Speculos Orchard FVK must decode");
+        let ovk = fvk.to_ovk(Scope::External);
+
+        let ext_div = Diversifier::from_bytes(EXT_RECIPIENT[..11].try_into().unwrap());
+        let ext_pk_d =
+            DiversifiedTransmissionKey::from_bytes(EXT_RECIPIENT[11..].try_into().unwrap())
+                .expect("ext_recipient pk_d must be valid");
+        let ext_addr = Address::from_parts(ext_div, ext_pk_d);
+
+        // _MEMO_NULLIFIER — the action's nullifier; the output rho derives from it.
+        let memo_nf_bytes: [u8; 32] = [
+            0x78, 0x1c, 0x4f, 0xaf, 0x96, 0x02, 0x06, 0x51, 0x0f, 0xdc, 0x72, 0x73, 0x92, 0x67,
+            0xfa, 0x19, 0x3d, 0x9e, 0x01, 0x2d, 0xbc, 0x68, 0x99, 0x8d, 0x35, 0x53, 0x98, 0x37,
+            0xe5, 0x20, 0xae, 0x2a,
+        ];
+        let nf_old = Nullifier::from_bytes(&memo_nf_bytes).expect("_MEMO_NULLIFIER must be valid");
+        let rho = Rho::from_nf_old(nf_old);
+
+        // _MEMO_RSEED = 0x29 followed by 31 zero bytes.
+        let memo_rseed_bytes: [u8; 32] = {
+            let mut b = [0u8; 32];
+            b[0] = 0x29;
+            b
+        };
+        let rseed = Option::from(RandomSeed::from_bytes(memo_rseed_bytes, &rho))
+            .expect("_MEMO_RSEED must be valid for rho");
+
+        let note: Note = Option::from(Note::from_parts(
+            ext_addr,
+            NoteValue::from_raw(90_000),
+            rho,
+            rseed,
+            NoteVersion::V3,
+        ))
+        .expect("memo output note must be valid");
+
+        (note, ovk)
+    }
+
+    /// Pad a memo's content into the 512-byte field a shielded note carries.
+    fn memo_field(content: &[u8]) -> [u8; 512] {
+        let mut memo = [0u8; 512];
+        memo[..content.len()].copy_from_slice(content);
+        memo
+    }
+
+    /// Generate updated V3 memo-action vectors for test_pczt_ironwood.py.
+    ///
+    /// The memo action is a dummy padding spend whose 90 000-zat output goes to
+    /// `_EXT_RECIPIENT` and carries an ASCII memo recovered through the external OVK.
+    ///
+    /// ```sh
+    /// HOST=$(rustc -vV | awk '/^host:/ {print $2}')
+    /// cd /tmp && cargo test --manifest-path <worktree>/vendor/orchard/Cargo.toml \
+    ///   --target "$HOST" --target-dir /tmp/orchard-host \
+    ///   --no-default-features --features std \
+    ///   -- gen_v3_memo_action_vectors --nocapture
+    /// ```
+    #[test]
+    fn gen_v3_memo_action_vectors() {
+        let (note, ovk) = memo_action_note_and_ovk();
+
+        let cmx = ExtractedNoteCommitment::from(note.commitment());
+        println!("\n# ---- V3 memo action (gen_v3_memo_action_vectors) ----");
+        println!(
+            "_MEMO_CMX = bytes.fromhex(\"{}\")",
+            hex_str(&cmx.to_bytes())
+        );
+
+        let memo = memo_field(b"PCZT Orchard memo test");
+
+        let esk = note.esk();
+        let encryptor = IronwoodNoteEncryption::new_with_esk(esk, Some(ovk), note, memo);
+        let epk_bytes = IronwoodDomain::epk_bytes(encryptor.epk());
+        println!(
+            "_MEMO_EPHEMERAL_KEY = bytes.fromhex(\"{}\")",
+            hex_str(&epk_bytes.0)
+        );
+        let enc_ct = encryptor.encrypt_note_plaintext();
+        println!(
+            "_MEMO_ENC_CIPHERTEXT = bytes.fromhex(\n    \"{}\"\n)",
+            hex_lines(enc_ct.as_ref())
+        );
+
+        // _MEMO_RCV = 0x3d …; the action spends nothing and outputs 90 000.
+        let memo_rcv_bytes: [u8; 32] = {
+            let mut b = [0u8; 32];
+            b[0] = 0x3d;
+            b
+        };
+        let rcv = ValueCommitTrapdoor::from_bytes(memo_rcv_bytes)
+            .into_option()
+            .expect("_MEMO_RCV must be a valid scalar");
+        let value_net = NoteValue::from_raw(0) - NoteValue::from_raw(90_000);
+        let cv_net = ValueCommitment::derive(value_net, rcv);
+        println!(
+            "_MEMO_CV_NET = bytes.fromhex(\"{}\")",
+            hex_str(&cv_net.to_bytes())
+        );
+
+        let out_ct = encryptor.encrypt_outgoing_plaintext(&cv_net, &cmx, &mut UnwrapErr(SysRng));
+        println!(
+            "_MEMO_OUT_CIPHERTEXT = bytes.fromhex(\n    \"{}\"\n)",
+            hex_lines(out_ct.as_ref())
+        );
+    }
+
+    /// Generate the V3 memo-action vector whose memo is not printable ASCII.
+    ///
+    /// `memo_display` renders a memo as text only when every one of its bytes falls in
+    /// 0x20..=0x7E, and hashes it otherwise. Reaching that hash branch over the real APDU path
+    /// therefore needs a ciphertext of its own — the committed one decrypts to printable ASCII
+    /// and takes the text branch. These five bytes are the memo a wallet produced from the word
+    /// `test` typed into a send form.
+    ///
+    /// Only `enc_ciphertext` is emitted; see `memo_action_note_and_ovk` for why the rest of the
+    /// action is unchanged. The commitment and ephemeral key are printed alongside so that a
+    /// reader can confirm it rather than take it on trust.
+    ///
+    /// ```sh
+    /// HOST=$(rustc -vV | awk '/^host:/ {print $2}')
+    /// cd /tmp && cargo test --manifest-path <worktree>/vendor/orchard/Cargo.toml \
+    ///   --target "$HOST" --target-dir /tmp/orchard-host \
+    ///   --no-default-features --features std \
+    ///   -- gen_v3_memo_action_line_break_vectors --nocapture
+    /// ```
+    #[test]
+    fn gen_v3_memo_action_line_break_vectors() {
+        let (note, ovk) = memo_action_note_and_ovk();
+
+        let cmx = ExtractedNoteCommitment::from(note.commitment());
+        let esk = note.esk();
+        let encryptor =
+            IronwoodNoteEncryption::new_with_esk(esk, Some(ovk), note, memo_field(b"test\n"));
+        let epk_bytes = IronwoodDomain::epk_bytes(encryptor.epk());
+
+        println!("\n# ---- V3 memo action with a line break (gen_v3_memo_action_line_break_vectors) ----");
+        println!("# unchanged, printed to show the memo reaches neither:");
+        println!("#   _MEMO_CMX           = {}", hex_str(&cmx.to_bytes()));
+        println!("#   _MEMO_EPHEMERAL_KEY = {}", hex_str(&epk_bytes.0));
+        println!(
+            "_MEMO_LINE_BREAK_ENC_CIPHERTEXT = bytes.fromhex(\n    \"{}\"\n)",
+            hex_lines(encryptor.encrypt_note_plaintext().as_ref())
+        );
+    }
+
+    // _INTERNAL_RECIPIENT — the account's internal-scope (change) address.
+    const INTERNAL_RECIPIENT: [u8; 43] = hex_decode_43(
+        b"ede3d2ce08c11d8c5c7bfe6814cedafd96c160c3d879cb270946f1ab6fdf442a15648d7c0b3c9fd052e20a",
+    );
+    const INTERNAL_SPEND_VALUE: u64 = 20_000;
+    const INTERNAL_SPEND_RHO: [u8; 32] = {
+        let mut b = [0u8; 32];
+        b[0] = 0x09;
+        b
+    };
+    const INTERNAL_SPEND_RSEED: [u8; 32] = {
+        let mut b = [0u8; 32];
+        b[0] = 0x1d;
+        b
+    };
+    const INTERNAL_OUTPUT_RSEED: [u8; 32] = {
+        let mut b = [0u8; 32];
+        b[0] = 0x31;
+        b
+    };
+    const INTERNAL_RCV: [u8; 32] = {
+        let mut b = [0u8; 32];
+        b[0] = 0x45;
+        b
+    };
+
+    /// The spend nullifier of a note paying `spend_recipient`, and the cmx of the
+    /// zero-valued output to `output_recipient` that the same action creates.
+    fn spend_nullifier_and_dummy_cmx(
+        fvk: &FullViewingKey,
+        spend_recipient: Address,
+        spend_value: u64,
+        spend_rho: [u8; 32],
+        spend_rseed: [u8; 32],
+        output_recipient: Address,
+        output_rseed: [u8; 32],
+        version: NoteVersion,
+    ) -> ([u8; 32], [u8; 32]) {
+        let spend_rho = Rho::from_bytes(&spend_rho)
+            .into_option()
+            .expect("spend rho must be valid");
+        let spend_rseed = Option::from(RandomSeed::from_bytes(spend_rseed, &spend_rho))
+            .expect("spend rseed must be valid for rho");
+        let spend_note: Note = Option::from(Note::from_parts(
+            spend_recipient,
+            NoteValue::from_raw(spend_value),
+            spend_rho,
+            spend_rseed,
+            version,
+        ))
+        .expect("spend note must be valid");
+        let nullifier = spend_note.nullifier(fvk).to_bytes();
+
+        let output_rho = Rho::from_bytes(&nullifier)
+            .into_option()
+            .expect("the nullifier must be a valid field element");
+        let output_rseed = Option::from(RandomSeed::from_bytes(output_rseed, &output_rho))
+            .expect("output rseed must be valid for rho");
+        let output_note: Note = Option::from(Note::from_parts(
+            output_recipient,
+            NoteValue::from_raw(0),
+            output_rho,
+            output_rseed,
+            version,
+        ))
+        .expect("output note must be valid");
+        (
+            nullifier,
+            ExtractedNoteCommitment::from(output_note.commitment()).to_bytes(),
+        )
+    }
+
+    fn address(raw: &[u8; 43]) -> Address {
+        Address::from_parts(
+            Diversifier::from_bytes(raw[..11].try_into().unwrap()),
+            DiversifiedTransmissionKey::from_bytes(raw[11..].try_into().unwrap())
+                .expect("pk_d must be valid"),
+        )
+    }
+
+    fn cv_net(spend_value: u64, rcv: [u8; 32]) -> [u8; 32] {
+        let rcv = ValueCommitTrapdoor::from_bytes(rcv)
+            .into_option()
+            .expect("rcv must be a valid scalar");
+        ValueCommitment::derive(
+            NoteValue::from_raw(spend_value) - NoteValue::from_raw(0),
+            rcv,
+        )
+        .to_bytes()
+    }
+
+    fn byte_tagged(tag: u8) -> [u8; 32] {
+        let mut b = [0u8; 32];
+        b[0] = tag;
+        b
+    }
+
+    /// Generate the vectors of a real spend of an internal-scope note, for
+    /// test_pczt_key_reuse.py.
+    ///
+    /// The note pays the account's change address, so the device recognizes it
+    /// through the internal IVK only. Its zero-valued output also goes to that
+    /// address and carries no ciphertext: the device then accepts it on the
+    /// recomputed cmx alone. Printed for both pools, which commit notes with
+    /// different versions. The same derivation first reproduces the committed
+    /// vectors of `_valid_orchard_action` and `_valid_ironwood_action`, which
+    /// the device already accepts.
+    ///
+    /// ```sh
+    /// HOST=$(rustc -vV | awk '/^host:/ {print $2}')
+    /// cd /tmp && cargo test --manifest-path <worktree>/vendor/orchard/Cargo.toml \
+    ///   --target "$HOST" --target-dir /tmp/orchard-host \
+    ///   --no-default-features --features std \
+    ///   -- gen_internal_spend_vectors --nocapture
+    /// ```
+    #[test]
+    fn gen_internal_spend_vectors() {
+        let fvk = FullViewingKey::from_bytes(&FVK_BYTES).expect("Speculos Orchard FVK must decode");
+        let internal = address(&INTERNAL_RECIPIENT);
+        assert_eq!(fvk.scope_for_address(&internal), Some(Scope::Internal));
+
+        // _valid_orchard_action / _valid_ironwood_action: an external-scope note.
+        let external_spend = |version| {
+            spend_nullifier_and_dummy_cmx(
+                &fvk,
+                address(&SPEND_RECIPIENT),
+                300_000,
+                byte_tagged(0x06),
+                byte_tagged(0x1a),
+                internal,
+                byte_tagged(0x2e),
+                version,
+            )
+        };
+        assert_eq!(
+            hex_str(&cv_net(300_000, byte_tagged(0x42))),
+            "00b3324110776396d31646041679fd6530d57c353c6be0a93a0cd55b30aa6d8b"
+        );
+        let (nf, cmx) = external_spend(NoteVersion::V2);
+        assert_eq!(
+            hex_str(&nf),
+            "08f337fd695cb5ca2ad7ced8ec14afed06d2f8a0e5e3d8b58dffbc69e4f81b2f"
+        );
+        assert_eq!(
+            hex_str(&cmx),
+            "825f806345d7c2ae67fe186120cc5b8a370c2cedb55ccf76527e9efa43c94d30"
+        );
+        let (nf, cmx) = external_spend(NoteVersion::V3);
+        assert_eq!(
+            hex_str(&nf),
+            "ed37cc733c228dc3dda2cf088ba646f9d204adc9d8d6f95ec36126eb742c3a10"
+        );
+        assert_eq!(
+            hex_str(&cmx),
+            "704b2bfa354eb974b10efe385d7ec56a12abbb906a3a95500bf9d6bbfcb7b73e"
+        );
+
+        println!("\n# ---- internal-scope spend (gen_internal_spend_vectors) ----");
+        println!(
+            "_INTERNAL_SPEND_CV_NET = bytes.fromhex(\"{}\")",
+            hex_str(&cv_net(INTERNAL_SPEND_VALUE, INTERNAL_RCV))
+        );
+        for (pool, version) in [("ORCHARD", NoteVersion::V2), ("IRONWOOD", NoteVersion::V3)] {
+            let (nullifier, cmx) = spend_nullifier_and_dummy_cmx(
+                &fvk,
+                internal,
+                INTERNAL_SPEND_VALUE,
+                INTERNAL_SPEND_RHO,
+                INTERNAL_SPEND_RSEED,
+                internal,
+                INTERNAL_OUTPUT_RSEED,
+                version,
+            );
+            println!(
+                "_{}_INTERNAL_SPEND_NULLIFIER = bytes.fromhex(\"{}\")",
+                pool,
+                hex_str(&nullifier)
+            );
+            println!(
+                "_{}_INTERNAL_SPEND_CMX = bytes.fromhex(\"{}\")",
+                pool,
+                hex_str(&cmx)
+            );
+        }
+    }
+}
