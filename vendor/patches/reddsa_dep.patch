+#[cfg(feature = "ledger")]
+impl VerificationKey<crate::orchard::SpendAuth> {
+    /// Creates a RedPallas spend authorization verification key from the given bytes.
+    pub fn from_ledger_verification_key(
+        verification_key: ledger_zcash_crypto::redpallas::SpendAuthVerificationKey,
+    ) -> Self {
+        let (bytes, point) = verification_key.into_parts();
+        VerificationKey {
+            point,
+            bytes: VerificationKeyBytes {
+                bytes,
+                _marker: PhantomData,
+            },
+        }
+    }
+}
