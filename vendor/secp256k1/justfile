_default:
  @just --list

alias ulf := update-lock-files

# Install workspace tools and toolchains.
@toolchains:
  cargo install --quiet --git https://git.rust-bitcoin.org/rust-bitcoin/rust-bitcoin-maintainer-tools --rev $(cat {{justfile_directory()}}/rbmt-version) cargo-rbmt --locked
  RBMT_LOG_LEVEL=progress cargo rbmt toolchains

# Run cargo-rbmt with given args.
@rbmt *args: toolchains
  RBMT_LOG_LEVEL=progress cargo rbmt {{args}}

# Lint everything.
@lint: (rbmt "lint")

# Test on stable with recent deps.
@test: (rbmt "test")

# Update the recent and minimal dependencies.
@update-lock-files: (rbmt "lock")
